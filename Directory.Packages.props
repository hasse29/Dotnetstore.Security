<Project>
  <PropertyGroup>
    <!-- Microsoft shared-framework packages track the target framework major version. -->
    <MsPackagesVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</MsPackagesVersion>
    <MsPackagesVersion Condition="'$(MsPackagesVersion)' == ''">10.0.14</MsPackagesVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MsPackagesVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(MsPackagesVersion)" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MsPackagesVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MsPackagesVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MsPackagesVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(MsPackagesVersion)" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>